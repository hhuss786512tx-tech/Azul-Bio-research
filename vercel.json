{
  "cleanUrls": true,
  "trailingSlash": false,
  "routes": [
    {
      "src": "/diversity(\\.html)?",
      "status": 301,
      "headers": { "Location": "/about-us" }
    },
    {
      "handle": "filesystem"
    },
    {
      "src": "/.*",
      "status": 404,
      "dest": "/404.html"
    }
  ]
}
